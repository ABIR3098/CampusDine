# Copy this file to .env and fill in your own values
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusdine

# any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# "*" allows any origin — simplest for local coursework use (also covers
# double-clicking the HTML file directly, which sends Origin: null).
# Once deployed, set this to your real frontend URL(s), comma separated.
CORS_ORIGIN=*


# Email (OTP codes). Leave SMTP_HOST empty to just print codes in the server console while developing.
# Gmail: turn on 2-step verification, then create an "App password" and put it in SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusDine <your_email@gmail.com>

# Email OTP on sign-up and password reset (default true). Set false to skip the code step.
EMAIL_OTP_REQUIRED=true

# Login 2FA: all = every account that has an email, admin = admin accounts only, off = no code at login.
LOGIN_OTP=all

# Canteen timezone: pre-order pickup times, the meal calendar and daily reports follow this clock.
# Default is Asia/Dhaka, so you only need this line if the canteen is somewhere else.
CANTEEN_TZ=Asia/Dhaka

# Optional Hall email notifications (leave unset to use in-app + Socket.IO only).
# These reuse the SMTP_* settings above; only the extras are listed here.
# SMTP_SECURE=false
# SMTP_FROM=CampusDine Hall <no-reply@example.com>
