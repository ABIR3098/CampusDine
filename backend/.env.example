# Copy this file to .env and fill in your own values
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campusdine

# any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# "*" allows any origin — simplest for local coursework use (also covers
# double-clicking the HTML file directly, which sends Origin: null).
# Once deployed, set this to your real frontend URL(s), comma separated.
CORS_ORIGIN=*
